CREATE TABLE genres(
	id INTEGER PRIMARY KEY AUTOINCREMENT,
	names varchar(50) NOT NULL
);
CREATE TABLE books (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  title varchar(150) NOT NULL,
  isbn varchar(17) UNIQUE,
  year0 INTEGER,
  price NUMERIC(8,2),
  in_stock INTEGER DEFAULT 1,
  genre_id INTEGER,
  FOREIGN KEY (genre_id)
        REFERENCES genres(id)
        ON DELETE SET NULL,
  CONSTRAINT chk_year CHECK (year0 BETWEEN 1800 and 2026),
  CONSTRAINT chk_stock CHECK (in_stock >= 0)
);
